# Copy to .env for local development. Never commit real secrets — deployed
# environments read these from AWS Secrets Manager (PRD §2).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgres://drugstore:drugstore@localhost:5433/drugstore
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Used only by the Vitest suite, which creates and migrates its own database.
# Read directly by vitest.config.ts, not through the env schema.
TEST_DATABASE_URL=postgres://drugstore:drugstore@localhost:5433/drugstore_test

# --- Redis (BullMQ queues, login throttling, Socket.IO adapter) --------------
REDIS_URL=redis://localhost:6379

# --- Auth -------------------------------------------------------------------
# 32+ chars. Rotate via Secrets Manager in deployed environments.
JWT_SECRET=change-me-in-production-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Static bearer token guarding /v1/internal/* (org + admin provisioning).
# This is NOT a user JWT and must never be issued to a client application.
INTERNAL_API_TOKEN=change-me-internal-token

# --- CORS -------------------------------------------------------------------
# Comma-separated allow-list of browser origins. Empty means "same-origin
# only", which blocks the admin dashboard outright — the API keeps working in
# curl and Postman, so a missing value here shows up only in the browser.
# Must list the dashboard's origin in every deployed environment.
CORS_ORIGINS=http://localhost:5173

# --- Integrations -----------------------------------------------------------
# "fake" runs without credentials (dev + tests).
#
# ROUTE_OPTIMIZER=googlemaps calls the Google Route Optimization API, which is
# a Cloud API: it needs GOOGLE_CLOUD_PROJECT_ID and a service account, NOT the
# Maps API key below. Boot fails loudly if you set it without them. The fake
# still sequences the queue, it just sorts by address instead of solving.
ROUTE_OPTIMIZER=fake

# Standardizes patient and pharmacy addresses so the route can be solved from
# real points, and powers the address autocomplete on the admin forms.
# "googlemaps" uses Places API (New) and needs only GOOGLE_MAPS_API_KEY.
# "fake" returns a small fixed set of Montreal addresses — enough for the
# dropdown to work end to end in dev without a key.
GEOCODER=fake
# Where the pharmacy delivers. Restricts suggestions; ISO 3166-1 alpha-2.
GEOCODE_COUNTRY=ca
# Language for the suggestions the employee reads.
GEOCODE_LANGUAGE=fr-CA

# Traffic-aware ETAs for the driver's remaining run (Routes API).
# "googlemaps" needs only GOOGLE_MAPS_API_KEY — the same plain key as Places,
# not the service account ROUTE_OPTIMIZER wants. "fake" derives legs from
# straight-line distance: deterministic, roughly right, and knows no traffic.
TRAVEL_TIME=fake
NOTIFICATION_SENDER=fake

MAPBOX_ACCESS_TOKEN=
# Places API (New). Restrict it to that API and to your server's IPs.
GOOGLE_MAPS_API_KEY=
# Route Optimization API — a Cloud API, so it authenticates as a service
# account rather than with the Maps key above.
#
# Only the project id is required. Leave the credentials empty to use
# Application Default Credentials: an attached service account on GCP, or
# `gcloud auth application-default login` on a laptop. That is preferred, and
# is the only option when your organization blocks service-account keys.
#
# If you do paste a key, it must be the JSON on ONE line — a .env value cannot
# span lines, and boot rejects anything that will not parse.
# Step-by-step: docs/google-cloud-setup.md
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Public base URL Twilio posts status callbacks to.
PUBLIC_BASE_URL=http://localhost:3000

# --- Retention (PRD §8.5) ---------------------------------------------------
DRIVER_LOCATION_RETENTION_DAYS=90
# Deliberately unset: the order anonymization job stays disabled until the
# pharmacy's legal counsel defines a retention window (PRD §12 Q4).
ORDER_RETENTION_DAYS=
