{
  "name": "medibus-server",
  "version": "1.0.0",
  "description": "Medibus Delivery App B2B — centralized API and real-time services",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:status": "tsx src/db/migrate.ts status",
    "seed": "tsx src/db/seed.ts",
    "openapi:dump": "tsx scripts/dump-openapi.ts",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:orders": "node scripts/verify-orders.mjs",
    "verify:driver": "node scripts/verify-driver.mjs",
    "verify:admin": "node scripts/verify-admin.mjs",
    "verify": "npm run verify:auth && npm run verify:orders && npm run verify:driver && npm run verify:admin",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^5.2.6",
    "@node-rs/argon2": "^2.0.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.28.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "google-auth-library": "^10.9.1",
    "ioredis": "^5.4.1",
    "knex": "^3.1.0",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pdfkit": "^0.13.6",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
